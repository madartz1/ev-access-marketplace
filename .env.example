# Server-only variables; never add a NEXT_PUBLIC_ prefix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&connection_limit=1"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Used only for one-time local admin provisioning; do not commit real values.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-strong-admin-password"
