generator client {
 provider = "prisma-client-js"
 previewFeatures = ["driverAdapters"]
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DATABASE_URL_UNPOOLED")
}
enum Role {
 CUSTOMER
 PARTNER
 ADMIN
}
enum Status {
 PENDING
 APPROVED
 REJECTED
}
enum BookingStatus {
 REQUESTED
 ACCEPTED
 DECLINED
 CANCELLED
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 name String
 role Role @default(CUSTOMER)
 createdAt DateTime @default(now())
 partner Partner?
 bookings Booking[]
}
model Partner {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id])
 businessName String
 kind String
 contactName String
 phone String
 address String
 website String?
 registrationNumber String
 insuranceCarrier String
 insurancePolicy String
 insuranceExpires DateTime
 tlcFleetLicense String?
 status Status @default(PENDING)
 vehicles Vehicle[]
 createdAt DateTime @default(now())
}
model Vehicle {
 id String @id @default(cuid())
 partnerId String
 partner Partner @relation(fields:[partnerId],references:[id])
 make String
 model String
 year Int
 vin String @unique
 plate String @unique
 vehicleType String
 seats Int
 rangeMiles Int
 dailyRateCents Int
 city String
 imageUrl String?
 description String?
 tlcEligible Boolean @default(false)
 tlcPlate String?
 insuranceExpires DateTime
 registrationExpires DateTime
 status Status @default(PENDING)
 bookings Booking[]
 createdAt DateTime @default(now())
}
model Booking {
 id String @id @default(cuid())
 customerId String
 customer User @relation(fields:[customerId],references:[id])
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 startDate DateTime
 endDate DateTime
 @@index([vehicleId, status, startDate, endDate])
 @@index([customerId])
 estimatedTotalCents Int
 useType String
 status BookingStatus @default(REQUESTED)
 createdAt DateTime @default(now())
}
